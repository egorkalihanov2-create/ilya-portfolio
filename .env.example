# Production only. Use a unique password of at least 16 characters.
ADMIN_PASSWORD=
# Exact public HTTPS origin, without a trailing slash.
SITE_ORIGIN=
# Use 1 only for a private local production run.
LOCAL_ADMIN=0
HOST=127.0.0.1
PORT=3000
# Optional persistent storage location on a Node hosting provider.
CONTENT_DIR=

# Optional GitHub publishing. Keep the token only in server/Railway variables.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
GITHUB_CONTENT_BRANCH=admin/customer-content
